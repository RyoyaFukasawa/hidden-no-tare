{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "node scripts/completion-check/check-work-items.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test scripts/**/*.test.ts",
    "verify": "node scripts/verify.ts",
    "verify:contract": "node scripts/workflow/check-contract.ts && node scripts/completion-check/check-work-items.ts && node scripts/adr/check.ts && node scripts/docs-check/check-layout.ts && node scripts/docs-check/check.ts markdown && node scripts/docs-check/check.ts links",
    "verify:project": "node scripts/workflow/verify-project.ts",
    "workflow:prepare": "node scripts/workflow/prepare.ts",
    "workflow:connection": "node scripts/workflow/connections.ts",
    "workflow:finalize": "node scripts/workflow/finalize.ts",
    "workflow:inspect-skill": "node scripts/workflow/inspect-skill.ts",
    "workflow:diagnose": "node scripts/workflow/diagnose.ts",
    "adr:generate": "node scripts/adr/generate.ts",
    "adr:check": "node scripts/adr/check.ts",
    "lint:md": "node scripts/docs-check/check.ts markdown",
    "lint:docs-layout": "node scripts/docs-check/check-layout.ts",
    "lint:links": "node scripts/docs-check/check.ts links",
    "lint:links:online": "node scripts/docs-check/check.ts links-online"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "markdownlint-cli2": "0.23.2"
  }
}
